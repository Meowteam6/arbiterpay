{
  "name": "confidential-shim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drop-in replacement for the Chainlink Confidential AI Attester HTTP contract, meant to run on a GCP Confidential VM (AMD SEV-SNP)",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "hono": "^4.7.0",
    "viem": "^2.55.17"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
