{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:demo": "playwright test --config playwright.demo.config.ts",
    "test:explore": "playwright test --config e2e/explorer/explorer.config.ts",
    "test:explore:env": "node -e \"const p = process.env.EXPLORER_ENV_FILE; if (p === undefined || p === '') { console.error('test:explore:env requires EXPLORER_ENV_FILE=<path to a sandbox dotenv file>'); process.exit(1); }\" && playwright test --config e2e/explorer/explorer.config.ts",
    "agent:provision": "node --env-file-if-exists=../.env --env-file-if-exists=.env.local --import tsx scripts/provision-spotter.ts"
  },
  "dependencies": {
    "@circle-fin/developer-controlled-wallets": "^10.8.0",
    "@circle-fin/x402-batching": "^3.0.4",
    "@dynamic-labs/ethereum": "^4.88.6",
    "@dynamic-labs/sdk-react-core": "^4.88.6",
    "@dynamic-labs/wagmi-connector": "^4.88.6",
    "@google/genai": "^2.15.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@swype-org/deposit": "^0.3.19",
    "@tanstack/react-query": "^5.101.0",
    "@unlink-xyz/sdk": "0.3.0-canary.598",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "jose": "^6.2.3",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "viem": "^2.52.0",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
